extends "res://tests/helpers/stage4_support.gd"

func _run() -> void:
    await _start()
    var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/animation_manifest.json"))
    var settings: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/player_visuals.json"))
    _check(int(manifest["step"]) >= 12 and manifest["clips"].size() == 18, "All newly generated player motions applied")
    var idle: Dictionary = hero.clip_data["idle"]
    var crop: Dictionary = idle.get("trim", {"x":0,"y":0,"w":640,"h":640})
    var image := Image.create(640,640,false,Image.FORMAT_RGBA8)
    var sheet: Image = hero.textures["idle"].get_image()
    sheet.convert(Image.FORMAT_RGBA8)
    image.blit_rect(sheet,Rect2i(0,0,int(crop["w"]),int(crop["h"])),Vector2i(int(crop["x"]),int(crop["y"])))
    var bounds: Rect2i = image.get_used_rect()
    _check(absf(bounds.size.y-363) <= 363*.03 and bounds.end.y == 600, "Standing height 363±3%, bottom anchor600")
    _check(hero.visual.scale == Vector2(.30,.30), "Player display scale unchanged")
    for clip: Dictionary in manifest["clips"]:
        _check(int(clip["anchor_px"][0]) == 320 and int(clip["anchor_px"][1]) == 600, "Every clip retains common foot anchor")
        _check(hero.textures.has(clip["name"]) and hero.clip_data[clip["name"]]["frames"] == clip["frames"], "Player reads generated manifest frames")
    var roll_stride: int = int(hero.clip_data["roll"].get("trim", {}).get("w",640))
    var slam_stride: int = int(hero.clip_data["attack_4"].get("trim", {}).get("w",640))
    hero._show_clip("roll",0.029)
    _check(hero.visual.region_rect.position.x == 0, "Roll startup uses one frame for first .03sec")
    hero._show_clip("roll",0.041)
    _check(hero.visual.region_rect.position.x == roll_stride, "Human shoulder roll second frame begins at .04sec")
    hero._show_clip("roll",0.281)
    _check(hero.visual.region_rect.position.x == roll_stride*7, "Roll recovery begins after .28sec")
    hero._show_clip("attack_4",0.339)
    _check(hero.visual.region_rect.position.x == slam_stride*5, "Before .34 slam retains pre-impact frame")
    hero._show_clip("attack_4",0.340)
    _check(hero.visual.region_rect.position.x == slam_stride*6, "Ground impact frame7 starts at shockwave .34sec")
    _check(settings["reference_height_px"] == 363 and settings["visual_scale"] == .30, "Visual data preserves reference size")
    await _finish("STAGE4_PLAYER_SCALE")
