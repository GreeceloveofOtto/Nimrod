{
  "#": {
    "collision": "solid",
    "render": "depth_crust_fill"
  },
  "W": {
    "collision": "solid",
    "wall_climbable": true
  },
  "=": {
    "collision": "one_way",
    "render": "painted_shelf_with_support"
  },
  ".": {
    "collision": "none",
    "render": "interior_backwall"
  },
  ":": {
    "collision": "none",
    "render": "exterior_parallax"
  },
  "^": {
    "collision": "solid_hazard",
    "damage": 12,
    "interval": 1
  },
  "F": {
    "collision": "linked_vision_gate",
    "render": "stone_picture_until_gate_open"
  },
  "~": {
    "collision": "none",
    "optional": true
  },
  "?": {
    "source_only": "preserve_background"
  }
}
