    "villa_intro": {
      "id": "villa_intro",
      "when": {
        "none": [
          "villa_intro_done"
        ]
      },
      "first": [
        {
          "speaker": "aya",
          "text": "니므롯, 어서와, 기다리고 있었어."
        },
        {
          "speaker": "shamash",
          "text": "니므롯, 너에게 거는 기대가 커. 너는 많은 것을 할 수 있을 거야."
        },
        {
          "speaker": "player",
          "text": "샤마쉬, 아야, 언제나 고마워."
        },
        {
          "speaker": "aya",
          "text": "니므롯, 식사를 준비했어. 함께 하면서 너의 업무를 전달할게."
        }
      ],
      "repeat": [],
      "flag": "story_dialogue_villa_intro",
      "speakers": [
