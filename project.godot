config_version=5

[application]
config/name="NIMROD | Lugal Castle and Uruk"
config/description="Nimrod: Lugal Castle, Uruk rooftops and the villa"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Audio="*res://scripts/audio_manager.gd"
GameState="*res://scripts/game_state.gd"
Dialogue="*res://scripts/dialogue_system.gd"
SceneManager="*res://scripts/scene_manager.gd"

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
2d/default_gravity=1750.0

[input]
move_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]
}
